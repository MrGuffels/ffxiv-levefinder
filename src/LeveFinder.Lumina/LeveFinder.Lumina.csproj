<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>LeveFinder.Lumina</RootNamespace>
    <AssemblyName>LeveFinder.Lumina</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned to match the Lumina build the user's current Dalamud dev
         install ships (Lumina 7.6.0, Lumina.Excel 7.5.1), so struct shapes
         match what ChilledLeves will eventually run against. -->
    <PackageReference Include="Lumina" Version="7.6.0" />
    <PackageReference Include="Lumina.Excel" Version="7.5.0" />
  </ItemGroup>
</Project>
